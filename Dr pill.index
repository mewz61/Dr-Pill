
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doctor Pill - Medication Reminder</title>
    <link rel="stylesheet" href="style.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body>

    <!-- DESKTOP / TABLET SIDEBAR -->
    <aside class="sidebar">
        <div class="brand">
            <!-- Custom Doctor Pill Vector Icon -->
            <svg class="brand-mascot" viewBox="0 0 100 100" width="44" height="44">
                <rect x="25" y="10" width="50" height="30" rx="15" fill="#16A34A" />
                <path d="M25 25 H75 V30 A10 10 0 0 1 65 40 H35 A10 10 0 0 1 25 30 Z" fill="#16A34A" />
                <rect x="42" y="14" width="16" height="5" fill="#FFFFFF" rx="2" />
                <rect x="47.5" y="8.5" width="5" height="16" fill="#FFFFFF" rx="2" />
                <circle cx="50" cy="50" r="22" fill="#FFFFFF" stroke="#16A34A" stroke-width="3" />
                <circle cx="42" cy="48" r="4" fill="#0F172A" />
                <circle cx="58" cy="48" r="4" fill="#0F172A" />
                <circle cx="38" cy="48" r="7" fill="none" stroke="#0F172A" stroke-width="2" />
                <circle cx="62" cy="48" r="7" fill="none" stroke="#0F172A" stroke-width="2" />
                <line x1="45" y1="48" x2="55" y2="48" stroke="#0F172A" stroke-width="2" />
                <path d="M 42 60 Q 50 67 58 60" fill="none" stroke="#0F172A" stroke-width="2.5" stroke-linecap="round" />
            </svg>
            <div>
                <h2>Doctor Pill</h2>
                <p>Your health, on time.</p>
            </div>
        </div>

        <nav class="nav-links">
            <button class="nav-btn active" onclick="switchTab('dashboard')">
                <i data-lucide="layout-dashboard"></i>
                <span>Dashboard</span>
            </button>
            <button class="nav-btn" onclick="switchTab('medications')">
                <i data-lucide="pill"></i>
                <span>My Medications</span>
            </button>
            <button class="nav-btn" onclick="switchTab('scanner')">
                <i data-lucide="scan-line"></i>
                <span>AI Box Scanner</span>
            </button>
            <button class="nav-btn" onclick="switchTab('security')">
                <i data-lucide="shield-check"></i>
                <span>Data Security</span>
            </button>
        </nav>

        <div class="user-profile">
            <div class="avatar">G</div>
            <div>
                <h4>Gregorio Santos</h4>
                <p>greg@example.com</p>
            </div>
        </div>
    </aside>

    <!-- MAIN CONTENT CONTAINER -->
    <main class="main-content">

        <!-- TAB 1: DASHBOARD -->
        <section id="tab-dashboard" class="tab-content active">
            <header class="top-header">
                <div>
                    <h1>Good Morning, Greg 👋</h1>
                    <p>Here is your daily health and medication overview.</p>
                </div>
                <button class="btn btn-primary" onclick="switchTab('medications')">
                    <i data-lucide="plus-circle"></i> Add Medication
                </button>
            </header>

            <!-- Hero Banner with Doctor Pill Mascot -->
            <div class="hero-card">
                <div class="hero-text">
                    <span class="badge">SDG 3 Aligned</span>
                    <h2>Dr. Pill is here to keep you on schedule!</h2>
                    <p>You have <strong>1 dose remaining</strong> for today. Stay consistent to keep your health streak active.</p>
                </div>
                <div class="mascot-container">
                    <svg viewBox="0 0 100 120" width="100" height="120">
                        <!-- Cap -->
                        <path d="M 20 35 C 20 15, 80 15, 80 35 Z" fill="#16A34A" />
                        <rect x="42" y="20" width="16" height="5" fill="#FFFFFF" rx="2" />
                        <rect x="47.5" y="14.5" width="5" height="16" fill="#FFFFFF" rx="2" />
                        <!-- Head -->
                        <circle cx="50" cy="50" r="24" fill="#FFFFFF" stroke="#16A34A" stroke-width="3" />
                        <!-- Glasses -->
                        <circle cx="40" cy="48" r="7" fill="none" stroke="#0F172A" stroke-width="2" />
                        <circle cx="60" cy="48" r="7" fill="none" stroke="#0F172A" stroke-width="2" />
                        <line x1="47" y1="48" x2="53" y2="48" stroke="#0F172A" stroke-width="2" />
                        <!-- Eyes -->
                        <circle cx="42" cy="48" r="3" fill="#0F172A" />
                        <circle cx="58" cy="48" r="3" fill="#0F172A" />
                        <!-- Smile -->
                        <path d="M 42 60 Q 50 67 58 60" fill="#0F172A" />
                        <!-- Body / Coat -->
                        <path d="M 25 74 L 35 110 L 65 110 L 75 74 Z" fill="#FFFFFF" stroke="#16A34A" stroke-width="3" />
                        <path d="M 40 74 L 50 90 L 60 74 Z" fill="#16A34A" />
                        <!-- Thumbs Up -->
                        <circle cx="82" cy="80" r="8" fill="#16A34A" />
                        <path d="M 80 75 L 80 83" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" />
                    </svg>
                </div>
            </div>

            <!-- Next Dose Alert Box -->
            <div class="alert-card">
                <div class="alert-icon">
                    <i data-lucide="clock"></i>
                </div>
                <div class="alert-details">
                    <span class="alert-tag">NEXT DOSE</span>
                    <h3 id="nextDoseTitle">Vitamin D3 (1000 IU)</h3>
                    <p id="nextDoseSub">Take 1 Capsule with water after meal</p>
                </div>
                <button class="btn btn-primary" id="takeDoseBtn" onclick="markDoseTaken()">
                    <i data-lucide="check"></i> Mark as Taken
                </button>
            </div>

            <!-- Quick Metrics Grid -->
            <div class="metrics-grid">
                <div class="metric-card">
                    <div class="metric-icon green"><i data-lucide="check-circle-2"></i></div>
                    <div>
                        <h3>85%</h3>
                        <p>Weekly Adherence</p>
                    </div>
                </div>
                <div class="metric-card">
                    <div class="metric-icon blue"><i data-lucide="flame"></i></div>
                    <div>
                        <h3>6 Days</h3>
                        <p>Current Streak</p>
                    </div>
                </div>
                <div class="metric-card">
                    <div class="metric-icon purple"><i data-lucide="shield-check"></i></div>
                    <div>
                        <h3>Protected</h3>
                        <p>Health Data</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- TAB 2: MY MEDICATIONS -->
        <section id="tab-medications" class="tab-content">
            <header class="top-header">
                <div>
                    <h1>My Medications</h1>
                    <p>Manage active prescription schedules (Max 10 Local Mock DB).</p>
                </div>
            </header>

            <div class="meds-layout">
                <!-- Add New Form -->
                <div class="card">
                    <h3><i data-lucide="plus"></i> Add Prescription</h3>
                    <form id="addMedForm" onsubmit="addMedication(event)">
                        <div class="form-group">
                            <label>Medication Name</label>
                            <input type="text" id="medName" placeholder="e.g., Paracetamol" required>
                        </div>
                        <div class="form-group">
                            <label>Dosage</label>
                            <input type="text" id="medDosage" placeholder="e.g., 2 tablets (500mg)" required>
                        </div>
                        <div class="form-group">
                            <label>Frequency / Time</label>
                            <input type="text" id="medTime" placeholder="e.g., Daily at 08:00 AM" required>
                        </div>
                        <button type="submit" class="btn btn-primary btn-block">Save to Local DB</button>
                    </form>
                </div>

                <!-- Active List -->
                <div class="card">
                    <div class="list-header">
                        <h3><i data-lucide="list"></i> Prescriptions List</h3>
                        <span class="db-pill-count" id="pillCounter">10 / 10 Pills</span>
                    </div>
                    <div id="medList" class="med-list">
                        <!-- Loaded dynamically via script.js -->
                    </div>
                </div>
            </div>
        </section>

        <!-- TAB 3: AI CAMERA SCANNER -->
        <section id="tab-scanner" class="tab-content">
            <header class="top-header">
                <div>
                    <h1>AI Box Scanner</h1>
                    <p>Scan your prescription box using live device camera feed.</p>
                </div>
            </header>

            <div class="scanner-card">
                <div class="scanner-viewport">
                    <video id="webcam" autoplay playsinline class="camera-feed hidden"></video>
                    <div id="scannerPlaceholder" class="scanner-placeholder">
                        <i data-lucide="camera" class="scan-icon"></i>
                        <p>Camera is currently turned off</p>
                    </div>
                    <div id="scanLaser" class="scan-laser hidden"></div>
                </div>

                <div class="scanner-controls">
                    <button id="startCamBtn" class="btn btn-primary btn-block" onclick="startCamera()">
                        <i data-lucide="video"></i> Open Live Camera
                    </button>
                    <button id="captureScanBtn" class="btn btn-primary btn-block hidden" onclick="captureAndScan()">
                        <i data-lucide="scan"></i> Scan Medicine Box
                    </button>
                </div>

                <!-- Scan Detection Output Modal/Card -->
                <div id="scanResult" class="scan-result hidden">
                    <div class="result-badge"><i data-lucide="check-circle"></i> Levocetirizine Box Detected</div>
                    <h3>Levocetirizine Dihydrochloride (5mg)</h3>
                    <p>Schedule Detected: Once daily at 09:00 AM</p>
                    <button class="btn btn-primary" onclick="addScannedMed()" style="margin-top: 1rem;">
                        <i data-lucide="plus"></i> Add to My Medications
                    </button>
                </div>
            </div>
        </section>

        <!-- TAB 4: DATA SECURITY -->
        <section id="tab-security" class="tab-content">
            <header class="top-header">
                <div>
                    <h1>Health Data Protection</h1>
                    <p>Your medical privacy and safety remain our highest priority.</p>
                </div>
            </header>

            <div class="security-grid">
                <div class="security-card">
                    <i data-lucide="lock" class="sec-icon"></i>
                    <h3>Privacy policy</h3>
                    <p>This application safeguards users’ personal and medication data through appropriate security measures. Information is collected solely to facilitate medication reminders and application functionality. Personal data is neither sold nor disclosed without a lawful basis. Users may request access, rectification or erasure, subject to applicable legislation. Access is restricted to authorised personnel.</p>
                    <p>Updated on 29/10/2026</p>
                </div>
                <div class="security-card">
                    <i data-lucide="shield" class="sec-icon"></i>
                    <h3>Data protection for Medication</h3>
                    <p>Medication data protection requires the secure collection, storage and processing of sensitive health information. Appropriate safeguards, including encryption, access controls and data minimisation, help prevent unauthorised disclosure. Use information for clearly defined purposes, with transparent privacy practices and respect for individuals’ rights to access, correct, or delete data.</p>
                    <p>Updated on 29/10/2026</p>
                </div>
                <div class="security-card">
                    <i data-lucide="key-round" class="sec-icon"></i>
                    <h3>Demonstration Only</h3>
                    <p>Dr Pill is designed to support medication reminders and organisation, not provide medical advice. The application does not diagnose conditions, recommend treatments or replace professional healthcare consultations. Users should consult qualified healthcare professionals regarding medication suitability, dosage, side effects or changes to treatment and seek urgent assistance during medical emergencies.</p>
                    <p>Updated on 29/10/2026</p>
                </div>
            </div>
        </section>

    </main>

    <!-- MOBILE NAVIGATION (Phones) -->
    <nav class="mobile-nav">
        <button class="m-btn active" onclick="switchTab('dashboard')">
            <i data-lucide="layout-dashboard"></i>
            <span>Home</span>
        </button>
        <button class="m-btn" onclick="switchTab('medications')">
            <i data-lucide="pill"></i>
            <span>Meds</span>
        </button>
        <button class="m-btn" onclick="switchTab('scanner')">
            <i data-lucide="scan-line"></i>
            <span>Scan</span>
        </button>
        <button class="m-btn" onclick="switchTab('security')">
            <i data-lucide="shield-check"></i>
            <span>Safety</span>
        </button>
    </nav>

    <script src="script.js"></script>
</body>
</html>
